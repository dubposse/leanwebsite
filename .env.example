# Stripe
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# Neon PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST/leanwebsite?sslmode=require

# Public base URL used for Stripe success/cancel redirects (https, or http://localhost for development)
SITE_URL=https://leanwebsite.matthiasbrehm.de

# Cloudflare R2 (private bucket; endpoint is derived from the account ID)
R2_ACCOUNT_ID=your-32-character-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-private-bucket-name
